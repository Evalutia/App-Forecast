    <entry>
      <name>CALC_UPSERT_VENTAS_MENSUALES</name>
      <type>SQL</type>
      <connection>MYSQL_EVALUTIA</connection>
      <sql><![CDATA[
-- Issue #112: ventana de 3 meses (mes en curso + 2 anteriores). Sin ella
-- esta query recalculaba el historico COMPLETO todas las noches: un UNION
-- sobre ~127M filas (stock_diario 107.8M + ventas_historicas 19.2M despues
-- del backfill de 10 anios de #104) para producir ~152k filas. Medido en
-- produccion el 02/08/2026: mas de 60 min en un solo INSERT, dejando la
-- planilla del cliente congelada (#111).
--
-- Los meses viejos no cambian con la operacion diaria (el cron extrae solo
-- "ayer"), asi que refrescarlos cada noche era trabajo puro perdido. Las
-- filas fuera de la ventana quedan intactas: esto acota QUE se recalcula,
-- no borra nada. Si un backfill historico reescribe meses viejos y hace
-- falta reflejarlos aca, hay que correr esta misma query UNA vez sin el
-- filtro de fecha (manual, fuera del cron); tambien existe el endpoint de
-- recalculo por SKU del backend (AdminService.RecalcForSku).
--
-- Por que 3 y no 13 meses (medido, no estimado -- DB local, 25.2M filas en
-- stock_diario, variante SELECT COUNT(*) de esta misma query):
--     sin ventana ............................. 353 s
--     ventana 13 meses (46% de las filas) ..... 453 s  <-- PEOR que sin ventana
--     ventana  3 meses (5.8% de las filas) .....  34 s  <-- 10x mejor
-- Con poca selectividad el rango por indice pierde contra el scan secuencial,
-- asi que una ventana "generosa" era contraproducente. 3 meses cubre de
-- sobra lo unico que la operacion diaria puede cambiar (ayer), con margen.
--
-- El corte se alinea al primer dia del mes a proposito: con un corte a
-- mitad de mes (ej. DATE_SUB(CURDATE(), INTERVAL 13 MONTH)) el mes del
-- borde se recalcularia con dias incompletos y dias_con_stock quedaria
-- subcontado para ese mes.
--
-- La expresion va repetida en las 4 subqueries en vez de una variable de
-- sesion a proposito: el step SQL de Pentaho parte el script por ';' y no
-- esta garantizado que los statements compartan conexion. Si la variable
-- llegara NULL, `fecha >= NULL` no matchea nada y el INSERT seria un no-op
-- SILENCIOSO. Dentro de un mismo statement CURDATE() se evalua una sola vez,
-- asi que las 4 copias son siempre consistentes entre si.
INSERT INTO ventas_mensuales
  (sku, year, month, ventas_cantidad, dias_con_stock, fuente, ts_carga)
SELECT
  u.sku, u.year, u.month,
  COALESCE(v.ventas_cantidad, 0) as ventas_cantidad,
  COALESCE(d.dias_con_stock, 0) as dias_con_stock,
  'calculado',
  -- Issue #122: mismo motivo que en el MERGE de arriba, UTC explicito.
  CONVERT_TZ(NOW(6), @@session.time_zone, '+00:00')
FROM (
  SELECT sku, YEAR(fecha) AS year, MONTH(fecha) AS month
  FROM ventas_historicas
  WHERE fecha >= DATE_SUB(DATE_FORMAT(CURDATE(), '%Y-%m-01'), INTERVAL 2 MONTH)
  UNION
  SELECT sku, YEAR(fecha) AS year, MONTH(fecha) AS month
  FROM stock_diario
  WHERE fecha >= DATE_SUB(DATE_FORMAT(CURDATE(), '%Y-%m-01'), INTERVAL 2 MONTH)
) u
LEFT JOIN (
  SELECT sku, YEAR(fecha) AS year, MONTH(fecha) AS month, SUM(cantidad) AS ventas_cantidad
  FROM ventas_historicas
  WHERE fecha >= DATE_SUB(DATE_FORMAT(CURDATE(), '%Y-%m-01'), INTERVAL 2 MONTH)
  GROUP BY sku, YEAR(fecha), MONTH(fecha)
) v ON v.sku = u.sku AND v.year = u.year AND v.month = u.month
LEFT JOIN (
  -- Issue #40: sumar todos los depositos por (sku, fecha) ANTES de comparar
  -- con stock_minimo -- stock_diario tiene una fila por deposito, y comparar
  -- fila por fila subcuenta dias con stock cuando esta repartido entre
  -- depositos sin que ninguno individual supere el minimo. Mismo patron que
  -- run_calc_planilla.py.
  SELECT agg.sku, YEAR(agg.fecha) AS year, MONTH(agg.fecha) AS month,
         COUNT(DISTINCT agg.fecha) AS dias_con_stock
  FROM (
    SELECT sd.sku, sd.fecha, SUM(sd.cantidad) AS stock_total
    FROM stock_diario sd
    WHERE sd.fecha >= DATE_SUB(DATE_FORMAT(CURDATE(), '%Y-%m-01'), INTERVAL 2 MONTH)
    GROUP BY sd.sku, sd.fecha
  ) agg
  JOIN articulos a ON a.sku = agg.sku
  WHERE agg.stock_total > COALESCE(a.stock_minimo,0)
  GROUP BY agg.sku, YEAR(agg.fecha), MONTH(agg.fecha)
) d ON d.sku = u.sku AND d.year = u.year AND d.month = u.month
ON DUPLICATE KEY UPDATE
  ventas_cantidad = VALUES(ventas_cantidad),
  dias_con_stock  = VALUES(dias_con_stock),
  actualizado_en = CONVERT_TZ(NOW(6), @@session.time_zone, '+00:00');
      ]]></sql>
      <xloc>2220</xloc><yloc>64</yloc><draw>Y</draw>
    </entry>

    <entry>
      <name>MARK VENTAS_MENSUALES FAILED</name>
      <type>SHELL</type>
      <filename>/bin/sh</filename>
      <work_directory>${Internal.Entry.Current.Directory}</work_directory>
      <arguments><argument>-c</argument></arguments>
      <insertScript>Y</insertScript>
      <script><![CDATA[
/bin/bash /app/services/etl/mark_step_failed.sh \
  "CALC_UPSERT_VENTAS_MENSUALES" \
  "El upsert de ventas_mensuales fallo -- ver log de la corrida. Ningun paso posterior lo lee (Issue #112), asi que solo queda desactualizada esa tabla." \
  "${ETL_FAIL_MARKER}"
      ]]></script>
      <wait>Y</wait>
      <xloc>2220</xloc><yloc>200</yloc><draw>Y</draw>
    </entry>

    <entry>
      <name>TRUNCATE VENTAS_STAGE END</name>
      <type>SQL</type>
      <connection>MYSQL_EVALUTIA</connection>
      <sql><![CDATA[
DELETE FROM ventas_historicas_stage;
      ]]></sql>
      <xloc>2400</xloc><yloc>64</yloc><draw>Y</draw>
    </entry>

    <entry>
      <name>MARK TRUNCATE END FAILED</name>
      <type>SHELL</type>
      <filename>/bin/sh</filename>
      <work_directory>${Internal.Entry.Current.Directory}</work_directory>
      <arguments><argument>-c</argument></arguments>
      <insertScript>Y</insertScript>
      <script><![CDATA[
/bin/bash /app/services/etl/mark_step_failed.sh \
  "TRUNCATE VENTAS_STAGE END" \
  "La limpieza de cortesia del stage al final de la corrida fallo -- de bajo riesgo: la proxima corrida se auto-protege igual con su propio TRUNCATE VENTAS_STAGE inicial." \
  "${ETL_FAIL_MARKER}"
      ]]></script>
      <wait>Y</wait>
      <xloc>2400</xloc><yloc>200</yloc><draw>Y</draw>
    </entry>

    <!-- Issue #131: gate final. Revisa si algun paso "marca y sigue" dejo
         ETL_FAIL_MARKER tocado: si nada fallo, sigue a SUCCESS; si algo
         fallo, va a FAILURE. Esto es lo que realmente determina el exit
         code de kitchen.sh (verificado contra el motor real: sin este gate,
         reconverger a SUCCESS resetea el resultado interno de Kettle y
         kitchen.sh devuelve 0 aunque el marker este presente). -->
    <entry>
      <name>CHECK RUN RESULT</name>
      <type>SHELL</type>
      <filename>/bin/sh</filename>
      <work_directory>${Internal.Entry.Current.Directory}</work_directory>
      <arguments><argument>-c</argument></arguments>
      <insertScript>Y</insertScript>
      <script><![CDATA[
if [ -f "${ETL_FAIL_MARKER}" ]; then
  echo "[CHECK_RUN_RESULT] Al menos un paso fallo esta corrida (ver jobs_historial, detalle.resultado='paso_fallido')."
  rm -f "${ETL_FAIL_MARKER}"
  exit 1
fi
echo "[CHECK_RUN_RESULT] Ningun paso fallo esta corrida."
exit 0
      ]]></script>
      <wait>Y</wait>
      <xloc>2580</xloc><yloc>64</yloc><draw>Y</draw>
    </entry>

    <entry>
      <name>SUCCESS</name>
      <type>SPECIAL</type>
      <success>Y</success>
      <xloc>2760</xloc><yloc>20</yloc><draw>Y</draw>
    </entry>

    <!-- Issue #131: NO es un SPECIAL con success=N. Verificado contra
         kitchen.sh real que ese atributo es un no-op (Kettle solo lo
         atiende para forzar EXITO en SUCCESS; no existe un equivalente
         "forzar fallo"). El tipo real que corta la ejecucion y vuelve
         false el resultado del job (y por lo tanto distinto de 0 el exit
         code de kitchen.sh) es el job entry nativo ABORT. -->
    <entry>
      <name>FAILURE</name>
      <type>ABORT</type>
      <message>job_etl_diario: al menos un paso fallo esta corrida (ver jobs_historial, detalle.resultado='paso_fallido' o 'abortado_temprano').</message>
      <xloc>2760</xloc><yloc>140</yloc><draw>Y</draw>
    </entry>
  </entries>

  <hops>
    <hop><from>START</from><to>RESET FAIL MARKER</to><enabled>Y</enabled><unconditional>Y</unconditional></hop>
    <hop><from>RESET FAIL MARKER</from><to>TRUNCATE VENTAS_STAGE</to><enabled>Y</enabled><unconditional>Y</unconditional></hop>

    <hop><from>TRUNCATE VENTAS_STAGE</from><to>RUN EXTRACT ARTICULOS</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>TRUNCATE VENTAS_STAGE</from><to>MARK TRUNCATE VENTAS_STAGE FAILED (ABORT)</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>MARK TRUNCATE VENTAS_STAGE FAILED (ABORT)</from><to>FAILURE</to><enabled>Y</enabled><unconditional>Y</unconditional></hop>

    <hop><from>RUN EXTRACT ARTICULOS</from><to>TRUNCATE STOCK_DIARIO_STAGE (opcional)</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>RUN EXTRACT ARTICULOS</from><to>MARK ARTICULOS FAILED</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>MARK ARTICULOS FAILED</from><to>TRUNCATE STOCK_DIARIO_STAGE (opcional)</to><enabled>Y</enabled><unconditional>Y</unconditional></hop>

    <hop><from>TRUNCATE STOCK_DIARIO_STAGE (opcional)</from><to>RUN EXTRACT STOCKXML</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>TRUNCATE STOCK_DIARIO_STAGE (opcional)</from><to>MARK STOCK STAGE TRUNCATE FAILED</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>MARK STOCK STAGE TRUNCATE FAILED</from><to>RUN EXTRACT STOCKXML</to><enabled>Y</enabled><unconditional>Y</unconditional></hop>

    <hop><from>RUN EXTRACT STOCKXML</from><to>MERGE STAGING -> STOCK_DIARIO</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>RUN EXTRACT STOCKXML</from><to>MARK STOCKXML FAILED</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>MARK STOCKXML FAILED</from><to>MERGE STAGING -> STOCK_DIARIO</to><enabled>Y</enabled><unconditional>Y</unconditional></hop>

    <hop><from>MERGE STAGING -> STOCK_DIARIO</from><to>RUN EXTRACT VENTAS</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>MERGE STAGING -> STOCK_DIARIO</from><to>MARK STOCK MERGE FAILED</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>MARK STOCK MERGE FAILED</from><to>RUN EXTRACT VENTAS</to><enabled>Y</enabled><unconditional>Y</unconditional></hop>

    <!-- Issue #124: antes este hop era unconditional, el MERGE corria aunque
         la extracción hubiera fallado; ahora solo sigue directo a MERGE si
         RUN EXTRACT VENTAS salió con éxito (exit 0), y si falló pasa primero
         por MARK VENTAS EXTRACT FAILED (deja el fallo registrado en
         jobs_historial).
         Actualizado por Issue #157 (el texto original decía que la rama de
         fallo "no toca ventas_historicas" y que las dos ramas reconvergían
         en RUN PREDICT.PY; las dos afirmaciones dejaron de ser ciertas):
         MARK VENTAS EXTRACT FAILED ya NO salta el MERGE, reconverge en el
         mismo MERGE STAGING -> VENTAS que la rama de éxito (ver el hop de
         abajo y su comentario); el WHERE del propio INSERT es lo que
         excluye solo los grupos fallidos, asi que la rama de fallo SI toca
         ventas_historicas, para los grupos que salieron bien. Las dos ramas
         reconvergen recien en RUN PREDICT.PY (no en CALC_UPSERT_VENTAS_MENSUALES,
         ver el comentario de #112 mas abajo que movio ese paso al final de
         la cadena), pero pasando primero por el MERGE, no saltandoselo. -->
    <hop><from>RUN EXTRACT VENTAS</from><to>MERGE STAGING -> VENTAS (con snapshot)</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>RUN EXTRACT VENTAS</from><to>MARK VENTAS EXTRACT FAILED</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <!-- Issue #157: antes iba directo a RUN PREDICT.PY, saltando el MERGE
         entero. Ahora reconverge al MERGE igual que la rama de exito; el
         WHERE del propio INSERT (ver esa entrada) es lo que excluye solo
         los grupos fallidos, asi que llegar aca ya no implica perder los
         grupos que si salieron bien. -->
    <hop><from>MARK VENTAS EXTRACT FAILED</from><to>MERGE STAGING -> VENTAS (con snapshot)</to><enabled>Y</enabled><unconditional>Y</unconditional></hop>

    <hop><from>MERGE STAGING -> VENTAS (con snapshot)</from><to>RUN PREDICT.PY</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>MERGE STAGING -> VENTAS (con snapshot)</from><to>MARK VENTAS MERGE FAILED</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>MARK VENTAS MERGE FAILED</from><to>RUN PREDICT.PY</to><enabled>Y</enabled><unconditional>Y</unconditional></hop>

    <hop><from>RUN PREDICT.PY</from><to>RUN CALC_PLANILLA</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>RUN PREDICT.PY</from><to>MARK PREDICT FAILED</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>MARK PREDICT FAILED</from><to>RUN CALC_PLANILLA</to><enabled>Y</enabled><unconditional>Y</unconditional></hop>

    <hop><from>RUN CALC_PLANILLA</from><to>RUN CALC_SUGERENCIAS</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>RUN CALC_PLANILLA</from><to>MARK CALC_PLANILLA FAILED</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>MARK CALC_PLANILLA FAILED</from><to>RUN CALC_SUGERENCIAS</to><enabled>Y</enabled><unconditional>Y</unconditional></hop>

    <hop><from>RUN CALC_SUGERENCIAS</from><to>RUN CALC_STOCK_RESUMEN</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>RUN CALC_SUGERENCIAS</from><to>MARK CALC_SUGERENCIAS FAILED</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>MARK CALC_SUGERENCIAS FAILED</from><to>RUN CALC_STOCK_RESUMEN</to><enabled>Y</enabled><unconditional>Y</unconditional></hop>

    <hop><from>RUN CALC_STOCK_RESUMEN</from><to>CALC_UPSERT_VENTAS_MENSUALES</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>RUN CALC_STOCK_RESUMEN</from><to>MARK CALC_STOCK_RESUMEN FAILED</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>MARK CALC_STOCK_RESUMEN FAILED</from><to>CALC_UPSERT_VENTAS_MENSUALES</to><enabled>Y</enabled><unconditional>Y</unconditional></hop>

    <hop><from>CALC_UPSERT_VENTAS_MENSUALES</from><to>TRUNCATE VENTAS_STAGE END</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>CALC_UPSERT_VENTAS_MENSUALES</from><to>MARK VENTAS_MENSUALES FAILED</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>MARK VENTAS_MENSUALES FAILED</from><to>TRUNCATE VENTAS_STAGE END</to><enabled>Y</enabled><unconditional>Y</unconditional></hop>

    <hop><from>TRUNCATE VENTAS_STAGE END</from><to>CHECK RUN RESULT</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>TRUNCATE VENTAS_STAGE END</from><to>MARK TRUNCATE END FAILED</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>MARK TRUNCATE END FAILED</from><to>CHECK RUN RESULT</to><enabled>Y</enabled><unconditional>Y</unconditional></hop>

    <hop><from>CHECK RUN RESULT</from><to>SUCCESS</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>CHECK RUN RESULT</from><to>FAILURE</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
  </hops>

  <job_parameters>
    <pass_all_parameters>Y</pass_all_parameters>
  </job_parameters>
</job>
